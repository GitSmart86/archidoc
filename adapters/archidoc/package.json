{
  "name": "archidoc",
  "version": "0.3.2",
  "description": "Architecture documentation compiler — C4 diagrams from source annotations. Downloads the native archidoc binary and includes the TypeScript adapter.",
  "bin": {
    "archidoc": "bin/archidoc.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js"
  },
  "dependencies": {
    "archidoc-ts": "^0.3.2"
  },
  "files": [
    "bin/",
    "scripts/"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "c4",
    "architecture",
    "documentation",
    "archidoc",
    "mermaid",
    "diagrams"
  ],
  "author": "The Archidoc Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GitSmart86/archidoc"
  },
  "homepage": "https://github.com/GitSmart86/archidoc#readme",
  "bugs": {
    "url": "https://github.com/GitSmart86/archidoc/issues"
  }
}
